            <div class="overflow-x-auto max-h-96">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100/90 backdrop-blur-md text-slate-700 border-b border-slate-200 dark:bg-slate-900/90 dark:text-slate-400 dark:border-slate-800 z-10">
