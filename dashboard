<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic & Research Performance Dashboard</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>

    <!-- External Charting & Parsing Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .dark ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        }
        .dark .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: none;
        }
        .pulse-dot {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-ring {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.15); }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen transition-colors duration-300 dark:bg-slate-950 dark:text-slate-100">

    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur-md px-4 lg:px-8 py-3 transition-colors dark:bg-slate-900/80 dark:border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3 w-full md:w-auto justify-between md:justify-start">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                        <i class="fa-solid font-bold text-white text-lg fa-chart-line"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900 dark:text-white">
                            Research Analytics Dashboard
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></span>
                            Live Google Sheet Stream
                        </p>
                    </div>
                </div>

                <button id="themeToggleMobile" class="md:hidden p-2.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:text-white">
                    <i class="fa-solid fa-moon dark:hidden text-indigo-600"></i>
                    <i class="fa-solid fa-sun hidden dark:inline text-amber-400"></i>
                </button>
            </div>

            <div class="flex items-center flex-wrap gap-3 w-full md:w-auto justify-between md:justify-end">
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs border border-slate-200 dark:bg-slate-800/80 dark:border-slate-700/60 dark:text-slate-300">
                    <i class="fa-solid fa-clock text-indigo-600 dark:text-indigo-400"></i>
                    <span>Next Sync: <strong id="timerDisplay" class="text-indigo-600 dark:text-indigo-400 font-mono">05:00</strong></span>
                </div>

                <div class="text-xs text-slate-500 dark:text-slate-400 hidden lg:block">
                    Updated: <span id="lastUpdated" class="font-medium text-slate-700 dark:text-slate-300">--:--:--</span>
                </div>

                <button id="refreshBtn" onclick="manualRefreshData()" class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition shadow-md shadow-indigo-600/20 active:scale-95">
                    <i id="refreshIcon" class="fa-solid fa-rotate"></i>
                    <span>Sync Now</span>
                </button>

                <a href="https://docs.google.com/spreadsheets/d/e/2PACX-1vTmXtMJ2MV48z61_oP66vuZWcjOk7Vi-eYFLx3wYm2CSqHu48yQC9hWti89IahLmDHHSWJHXRXL29T-/pubhtml" target="_blank" rel="noopener noreferrer" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs border border-slate-300 transition dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 dark:border-slate-700">
                    <i class="fa-solid fa-external-link text-xs"></i>
                    <span>Source Sheet</span>
                </a>

                <button id="themeToggleDesktop" class="hidden md:flex p-2 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-300 transition dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">
                    <i class="fa-solid fa-moon dark:hidden text-indigo-600"></i>
                    <i class="fa-solid fa-sun hidden dark:inline text-amber-400"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 lg:px-8 py-6 space-y-6">

        <!-- Status Toast Banner -->
        <div id="statusAlert" class="hidden p-4 rounded-xl border flex items-center justify-between transition-all duration-300">
            <div class="flex items-center gap-3">
                <i id="statusIcon" class="fa-solid fa-circle-check text-xl"></i>
                <div>
                    <h4 id="statusTitle" class="font-semibold text-sm">Notice</h4>
                    <p id="statusMsg" class="text-xs text-slate-600 dark:text-slate-300">Syncing live dataset...</p>
                </div>
            </div>
            <button onclick="dismissAlert()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-1">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- KPI 1: Demography -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Demography</span>
                    <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-200 text-blue-600 dark:bg-blue-500/10 dark:border-blue-500/20 dark:text-blue-400 flex items-center justify-center">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline justify-between">
                    <h3 id="kpiDemography" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    <span id="kpiDemographySub" class="text-xs text-blue-600 dark:text-blue-400 font-medium">-- groups</span>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Total Personnel / Authors</p>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 to-indigo-500"></div>
            </div>

            <!-- KPI 2: Grant Type -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Grant Type</span>
                    <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-600 dark:bg-emerald-500/10 dark:border-emerald-500/20 dark:text-emerald-400 flex items-center justify-center">
                        <i class="fa-solid fa-sack-dollar"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline justify-between">
                    <h3 id="kpiGrantType" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    <span id="kpiGrantTypeSub" class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">-- Categories</span>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Active Grant Streams</p>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
            </div>

            <!-- KPI 3: PD Status -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">PD Status</span>
                    <div class="w-9 h-9 rounded-xl bg-purple-50 border border-purple-200 text-purple-600 dark:bg-purple-500/10 dark:border-purple-500/20 dark:text-purple-400 flex items-center justify-center">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline justify-between">
                    <h3 id="kpiPdStatus" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    <span id="kpiPdStatusSub" class="text-xs text-purple-600 dark:text-purple-400 font-medium">-- Active</span>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Postdoctoral Fellows</p>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-purple-500 to-pink-500"></div>
            </div>

            <!-- KPI 4: Publication -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">KPI Publication</span>
                    <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200 text-amber-600 dark:bg-amber-500/10 dark:border-amber-500/20 dark:text-amber-400 flex items-center justify-center">
                        <i class="fa-solid fa-book-bookmark"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline justify-between">
                    <h3 id="kpiPublication" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    <span id="kpiPublicationSub" class="text-xs text-amber-600 dark:text-amber-400 font-medium">Target Papers</span>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Total Publications</p>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-500"></div>
            </div>

            <!-- KPI 5: Achieved -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">KPI Achieved</span>
                    <div class="w-9 h-9 rounded-xl bg-cyan-50 border border-cyan-200 text-cyan-600 dark:bg-cyan-500/10 dark:border-cyan-500/20 dark:text-cyan-400 flex items-center justify-center">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline justify-between">
                    <h3 id="kpiAchieved" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    <span id="kpiAchievedSub" class="text-xs text-cyan-600 dark:text-cyan-400 font-medium">Met Milestones</span>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Total Met KPI Output</p>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-500 to-blue-500"></div>
            </div>

            <!-- KPI 6: Citation -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Citations</span>
                    <div class="w-9 h-9 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 dark:bg-rose-500/10 dark:border-rose-500/20 dark:text-rose-400 flex items-center justify-center">
                        <i class="fa-solid fa-quote-right"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline justify-between">
                    <h3 id="kpiCitation" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    <span id="kpiCitationSub" class="text-xs text-rose-600 dark:text-rose-400 font-medium">Citations</span>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Total Academic Impact</p>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-rose-500 to-red-500"></div>
            </div>

            <!-- KPI 7: H-Index -->
            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden transition-all duration-300 sm:col-span-2 lg:col-span-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">H-Index Insights</span>
                    <div class="w-9 h-9 rounded-xl bg-violet-50 border border-violet-200 text-violet-600 dark:bg-violet-500/10 dark:border-violet-500/20 dark:text-violet-400 flex items-center justify-center">
                        <i class="fa-solid fa-award"></i>
                    </div>
                </div>
                <div class="mt-3 grid grid-cols-2 gap-4">
                    <div>
                        <span class="text-xs text-slate-500 dark:text-slate-400">Highest H-Index</span>
                        <h3 id="kpiHIndexMax" class="text-2xl font-extrabold text-violet-600 dark:text-violet-400">--</h3>
                    </div>
                    <div>
                        <span class="text-xs text-slate-500 dark:text-slate-400">Avg H-Index</span>
                        <h3 id="kpiHIndexAvg" class="text-2xl font-extrabold text-slate-900 dark:text-white">--</h3>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-violet-500 to-purple-600"></div>
            </div>

        </div>

        <div class="glass-panel p-4 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 w-full md:w-auto">
                <i class="fa-solid fa-filter text-indigo-600 dark:text-indigo-400"></i>
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Filter Dataset:</span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 w-full md:w-auto flex-1 max-w-4xl">
                <!-- Search -->
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                    <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Search records..." class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-slate-50 border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-indigo-500 dark:bg-slate-800/80 dark:border-slate-700 dark:text-slate-100">
                </div>

                <!-- Grant Filter -->
                <select id="filterGrant" onchange="applyFilters()" class="w-full px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-300 text-xs text-slate-800 focus:outline-none focus:border-indigo-500 dark:bg-slate-800/80 dark:border-slate-700 dark:text-slate-200">
                    <option value="ALL">All Grant Types</option>
                </select>

                <!-- PD Status Filter -->
                <select id="filterPdStatus" onchange="applyFilters()" class="w-full px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-300 text-xs text-slate-800 focus:outline-none focus:border-indigo-500 dark:bg-slate-800/80 dark:border-slate-700 dark:text-slate-200">
                    <option value="ALL">All PD Statuses</option>
                </select>

                <!-- Country / Negara Filter -->
                <select id="filterCountry" onchange="applyFilters()" class="w-full px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-300 text-xs text-slate-800 focus:outline-none focus:border-indigo-500 dark:bg-slate-800/80 dark:border-slate-700 dark:text-slate-200">
                    <option value="ALL">Semua Negara (All Countries)</option>
                </select>
            </div>

            <button onclick="resetFilters()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium border border-slate-300 transition dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 dark:border-slate-700 w-full md:w-auto">
                Reset Filters
            </button>
        </div>

        <div class="pt-2">
            <div class="flex items-center gap-2 mb-4">
                <div class="w-2.5 h-6 bg-indigo-600 rounded-full"></div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white">Statistik & Demografi Postdoc</h2>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Postdoc Chart 1: Lantikan vs Tamat -->
                <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Lantikan & Tamat Postdoc Mengikut Tahun</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Perbandingan tahun lantikan dan jangkaan/tahun tamat</p>
                        </div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-600 border border-indigo-200 dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20">
                            Yearly Comparison
                        </span>
                    </div>
                    <div class="relative w-full h-72">
                        <canvas id="postdocYearChart"></canvas>
                    </div>
                </div>

                <!-- Postdoc Chart 2: Country Distribution -->
                <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Taburan Postdoc Mengikut Negara</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Pecahan asal negara / kewarganegaraan penyelidik</p>
                        </div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-teal-50 text-teal-600 border border-teal-200 dark:bg-teal-500/10 dark:text-teal-400 dark:border-teal-500/20">
                            Country Demographics
                        </span>
                    </div>
                    <div class="relative w-full h-72">
                        <canvas id="postdocCountryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Chart 1: Line Chart -->
            <div class="glass-panel p-5 rounded-2xl lg:col-span-2 flex flex-col justify-between shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Publications & Citations Growth Trend</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Dynamic progression of citations vs publication counts</p>
                    </div>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-600 border border-indigo-200 dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20">
                        Line Chart
                    </span>
                </div>
                <div class="relative w-full h-72">
                    <canvas id="lineChart"></canvas>
                </div>
            </div>

            <!-- Chart 2: Pie / Doughnut Chart -->
            <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Demography Distribution</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Proportional breakdown by faculty & research group</p>
                    </div>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20">
                        Pie Chart
                    </span>
                </div>
                <div class="relative w-full h-72 flex items-center justify-center">
                    <canvas id="pieChart"></canvas>
                </div>
            </div>

            <!-- Chart 3: Bar Chart -->
            <div class="glass-panel p-5 rounded-2xl lg:col-span-2 flex flex-col justify-between shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">KPI Achieved vs Target by Grant Type</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Comparison across active funding categories</p>
                    </div>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-50 text-amber-600 border border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20">
                        Bar Chart
                    </span>
                </div>
                <div class="relative w-full h-72">
                    <canvas id="barChart"></canvas>
                </div>
            </div>

            <!-- Chart 4: PD Status Chart -->
            <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">PD Status Breakdown</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Active, Completed & Pending Statuses</p>
                    </div>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-50 text-purple-600 border border-purple-200 dark:bg-purple-500/10 dark:text-purple-400 dark:border-purple-500/20">
                        Status
                    </span>
                </div>
                <div class="relative w-full h-72 flex items-center justify-center">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

        </div>

        <div class="glass-panel rounded-2xl overflow-hidden shadow-sm">
