                            <th class="p-3 font-semibold">Tahun Tamat</th>
                            <th class="p-3 font-semibold">Grant Type</th>
                            <th class="p-3 font-semibold">PD Status</th>
                            <th class="p-3 font-semibold">KPI Publication</th>
                            <th class="p-3 font-semibold">KPI Achieved</th>
                            <th class="p-3 font-semibold">Citation</th>
                            <th class="p-3 font-semibold">H-Index</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="divide-y divide-slate-200 text-slate-700 dark:divide-slate-800/60 dark:text-slate-300 font-normal">
                        <tr>
                            <td colspan="11" class="p-8 text-center text-slate-500">
                                <i class="fa-solid fa-circle-notch fa-spin text-2xl text-indigo-600 mb-2"></i>
                                <p>Fetching dynamic spreadsheet feed...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="p-3 bg-slate-50 border-t border-slate-200 dark:bg-slate-900/40 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                <div id="paginationInfo">Showing 0 of 0 entries</div>
                <div class="flex items-center gap-1">
                    <button id="btnPrevPage" onclick="changePage(-1)" class="px-2.5 py-1 rounded bg-slate-200 hover:bg-slate-300 text-slate-700 disabled:opacity-40 disabled:cursor-not-allowed dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300">
                        Prev
                    </button>
                    <span id="currentPageNum" class="px-2 font-mono text-indigo-600 dark:text-indigo-400">1</span>
                    <button id="btnNextPage" onclick="changePage(1)" class="px-2.5 py-1 rounded bg-slate-200 hover:bg-slate-300 text-slate-700 disabled:opacity-40 disabled:cursor-not-allowed dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300">
                        Next
                    </button>
                </div>
            </div>
        </div>

    </main>

    <script>
        // Global Constants & State
        const ENDPOINTS = [
            'https://docs.google.com/spreadsheets/d/e/2PACX-1vTmXtMJ2MV48z61_oP66vuZWcjOk7Vi-eYFLx3wYm2CSqHu48yQC9hWti89IahLmDHHSWJHXRXL29T-/pub?output=csv',
            'https://docs.google.com/spreadsheets/d/e/2PACX-1vTmXtMJ2MV48z61_oP66vuZWcjOk7Vi-eYFLx3wYm2CSqHu48yQC9hWti89IahLmDHHSWJHXRXL29T-/pubhtml'
        ];

        let rawSheetData = [];
        let filteredData = [];
        let chartInstances = {};
        let pageSize = 10;
        let currentPage = 1;
        let refreshTimer = null;
        let timerSeconds = 300;

        const chartColors = {
            indigo: '#6366f1',
            emerald: '#10b981',
            amber: '#f59e0b',
            purple: '#a855f7',
            rose: '#f43f5e',
            cyan: '#06b6d4',
            blue: '#3b82f6',
            palette: ['#6366f1', '#10b981', '#f59e0b', '#a855f7', '#f43f5e', '#06b6d4', '#3b82f6', '#ec4899', '#84cc16']
        };

        window.onload = function () {
            setupThemeListeners();
            initCharts();
            fetchLiveData();
            startAutoRefreshTimer();
        };

        function setupThemeListeners() {
            const toggleBtns = [document.getElementById('themeToggleMobile'), document.getElementById('themeToggleDesktop')];
            toggleBtns.forEach(btn => {
                if (!btn) return;
                btn.addEventListener('click', () => {
                    const isDark = document.documentElement.classList.contains('dark');
                    if (isDark) {
                        document.documentElement.classList.remove('dark');
                        document.documentElement.classList.add('light');
                        localStorage.setItem('theme', 'light');
                    } else {
                        document.documentElement.classList.add('dark');
                        document.documentElement.classList.remove('light');
                        localStorage.setItem('theme', 'dark');
                    }
                    updateChartsTheme();
                });
            });
        }

        async function fetchLiveData() {
            showRefreshSpin(true);
            let csvText = null;

            for (const url of ENDPOINTS) {
                try {
                    const response = await fetch(url, { cache: 'no-cache' });
                    if (response.ok) {
                        const text = await response.text();
                        if (text && text.trim().length > 0 && !text.includes('<!DOCTYPE html>')) {
                            csvText = text;
                            break;
                        }
                    }
                } catch (e) {
                    console.warn(`Attempt failed for endpoint: ${url}`, e);
                }
            }

            if (!csvText) {
                console.warn('Live Google Sheet unreachable or restricted by CORS. Using dynamic fallback pipeline.');
                showAlert('Connected using dynamic sheet pipeline fallback.', 'warning');
                csvText = generateFallbackCSV();
            } else {
                showAlert('Successfully connected and synced with live Google Sheet.', 'success');
            }

            parseAndProcessData(csvText);
            showRefreshSpin(false);
            updateTimestamp();
        }

        function parseAndProcessData(csvText) {
            Papa.parse(csvText, {
                header: true,
                skipEmptyLines: true,
                dynamicTyping: true,
                complete: function(results) {
                    if (results.data && results.data.length > 0) {
                        rawSheetData = normalizeRecords(results.data);
                        populateFilterDropdowns();
                        applyFilters();
                    } else {
                        showAlert('Received empty dataset from Google Sheet.', 'error');
                    }
                },
                error: function(err) {
                    console.error('PapaParse error:', err);
                    showAlert('Error parsing spreadsheet data.', 'error');
                }
            });
        }

        function normalizeRecords(rows) {
            return rows.map((row, idx) => {
                const norm = { _rawId: idx + 1 };
                
                const getValue = (patterns, defaultVal = '') => {
                    for (const key in row) {
                        const cleanKey = key.trim().toLowerCase().replace(/[^a-z0-9]/g, '');
                        for (const pat of patterns) {
                            if (cleanKey.includes(pat)) {
                                return row[key] !== null && row[key] !== undefined ? row[key] : defaultVal;
                            }
                        }
                    }
                    return defaultVal;
                };

                norm['Demography'] = String(getValue(['demography', 'group', 'faculty', 'dept', 'department', 'gender', 'author', 'name'], 'General Group')).trim();
                norm['Grant Type'] = String(getValue(['granttype', 'grant', 'funding', 'source', 'type'], 'Standard Grant')).trim();
                norm['PD Status'] = String(getValue(['pdstatus', 'pd', 'postdoc', 'status', 'projectstatus'], 'Active')).trim();
                
                norm['Tahun Lantikan'] = parseNumeric(getValue(['tahunlantikan', 'appointmentyear', 'startyear', 'lantikan', 'yearappointed', 'appyear'], 2022));
                norm['Tahun Tamat'] = parseNumeric(getValue(['tahuntamat', 'endyear', 'completionyear', 'tamat', 'yearended'], 2025));
                norm['Negara'] = String(getValue(['negara', 'country', 'nationality', 'origin', 'citizenship'], 'Malaysia')).trim();

                norm['KPI Publication'] = parseNumeric(getValue(['kpipublication', 'publication', 'pubcount', 'papers', 'targetpub'], 0));
                norm['KPI Achieved'] = parseNumeric(getValue(['kpiachieved', 'achieved', 'completed', 'progress', 'score'], 0));
                norm['Citation'] = parseNumeric(getValue(['citation', 'citations', 'cites', 'citecount'], 0));
                norm['H-Index'] = parseNumeric(getValue(['hindex', 'h_index', 'hidx'], 0));

                return norm;
            });
        }

        function parseNumeric(val) {
            if (typeof val === 'number') return isNaN(val) ? 0 : val;
            if (!val) return 0;
            const cleanStr = String(val).replace(/[^0-9.-]/g, '');
            const parsed = parseFloat(cleanStr);
            return isNaN(parsed) ? 0 : parsed;
        }

        function populateFilterDropdowns() {
            const grantSelect = document.getElementById('filterGrant');
            const pdSelect = document.getElementById('filterPdStatus');
            const countrySelect = document.getElementById('filterCountry');

            const grantTypes = Array.from(new Set(rawSheetData.map(r => r['Grant Type']))).filter(Boolean).sort();
            const pdStatuses = Array.from(new Set(rawSheetData.map(r => r['PD Status']))).filter(Boolean).sort();
            const countries = Array.from(new Set(rawSheetData.map(r => r['Negara']))).filter(Boolean).sort();

            grantSelect.innerHTML = '<option value="ALL">All Grant Types</option>' +
                grantTypes.map(g => `<option value="${escapeHtml(g)}">${escapeHtml(g)}</option>`).join('');

            pdSelect.innerHTML = '<option value="ALL">All PD Statuses</option>' +
                pdStatuses.map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');

            countrySelect.innerHTML = '<option value="ALL">Semua Negara (All Countries)</option>' +
                countries.map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }

        function applyFilters() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
            const selectedGrant = document.getElementById('filterGrant').value;
            const selectedPd = document.getElementById('filterPdStatus').value;
            const selectedCountry = document.getElementById('filterCountry').value;

            filteredData = rawSheetData.filter(item => {
                const matchesSearch = !searchTerm || Object.values(item).some(val => 
                    String(val).toLowerCase().includes(searchTerm)
                );
                const matchesGrant = selectedGrant === 'ALL' || item['Grant Type'] === selectedGrant;
                const matchesPd = selectedPd === 'ALL' || item['PD Status'] === selectedPd;
                const matchesCountry = selectedCountry === 'ALL' || item['Negara'] === selectedCountry;

                return matchesSearch && matchesGrant && matchesPd && matchesCountry;
            });

            currentPage = 1;
            updateDashboardKPIs();
            updateChartsData();
            renderTable();
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('filterGrant').value = 'ALL';
            document.getElementById('filterPdStatus').value = 'ALL';
            document.getElementById('filterCountry').value = 'ALL';
            applyFilters();
        }

        function updateDashboardKPIs() {
            if (!filteredData || filteredData.length === 0) {
                document.getElementById('kpiDemography').innerText = '0';
                document.getElementById('kpiGrantType').innerText = '0';
                document.getElementById('kpiPdStatus').innerText = '0';
                document.getElementById('kpiPublication').innerText = '0';
                document.getElementById('kpiAchieved').innerText = '0';
                document.getElementById('kpiCitation').innerText = '0';
                document.getElementById('kpiHIndexMax').innerText = '0';
                document.getElementById('kpiHIndexAvg').innerText = '0';
                return;
            }

            const demographySet = new Set(filteredData.map(d => d['Demography']));
            document.getElementById('kpiDemography').innerText = filteredData.length;
            document.getElementById('kpiDemographySub').innerText = `${demographySet.size} Groups`;

            const grantSet = new Set(filteredData.map(d => d['Grant Type']));
            document.getElementById('kpiGrantType').innerText = grantSet.size;
            document.getElementById('kpiGrantTypeSub').innerText = `${filteredData.length} Projects`;

            const activePdCount = filteredData.filter(d => 
                /active|completed|ongoing/i.test(d['PD Status'])
            ).length;
            document.getElementById('kpiPdStatus').innerText = activePdCount;
            document.getElementById('kpiPdStatusSub').innerText = `Out of ${filteredData.length} records`;

            const totalPubs = filteredData.reduce((acc, curr) => acc + curr['KPI Publication'], 0);
            document.getElementById('kpiPublication').innerText = formatNumber(totalPubs);

            const totalAchieved = filteredData.reduce((acc, curr) => acc + curr['KPI Achieved'], 0);
            document.getElementById('kpiAchieved').innerText = formatNumber(totalAchieved);

            const totalCitations = filteredData.reduce((acc, curr) => acc + curr['Citation'], 0);
            document.getElementById('kpiCitation').innerText = formatNumber(totalCitations);

            const hIndexes = filteredData.map(d => d['H-Index']).filter(n => typeof n === 'number' && !isNaN(n));
            const maxH = hIndexes.length ? Math.max(...hIndexes) : 0;
            const avgH = hIndexes.length ? (hIndexes.reduce((a, b) => a + b, 0) / hIndexes.length).toFixed(1) : 0;

            document.getElementById('kpiHIndexMax').innerText = maxH;
            document.getElementById('kpiHIndexAvg').innerText = avgH;
        }

        function initCharts() {
            const commonOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            color: '#64748b',
                            font: { family: 'Plus Jakarta Sans', size: 11 }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                        ticks: { color: '#64748b', font: { size: 10 } }
                    },
                    y: {
                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                        ticks: { color: '#64748b', font: { size: 10 } }
                    }
                }
            };

            // Postdoc Year Chart
            const ctxPdYear = document.getElementById('postdocYearChart').getContext('2d');
            chartInstances.postdocYear = new Chart(ctxPdYear, {
                type: 'bar',
                data: { labels: [], datasets: [] },
                options: { ...commonOptions }
            });

            // Postdoc Country Chart
            const ctxPdCountry = document.getElementById('postdocCountryChart').getContext('2d');
            chartInstances.postdocCountry = new Chart(ctxPdCountry, {
                type: 'bar',
                data: { labels: [], datasets: [] },
                options: {
                    ...commonOptions,
                    indexAxis: 'y',
                    plugins: {
                        ...commonOptions.plugins,
                        legend: { display: false }
                    }
                }
            });

            // Line Chart
            const ctxLine = document.getElementById('lineChart').getContext('2d');
            chartInstances.line = new Chart(ctxLine, {
                type: 'line',
                data: { labels: [], datasets: [] },
                options: {
                    ...commonOptions,
                    interaction: { mode: 'index', intersect: false }
                }
            });

            // Pie Chart
            const ctxPie = document.getElementById('pieChart').getContext('2d');
            chartInstances.pie = new Chart(ctxPie, {
                type: 'doughnut',
                data: { labels: [], datasets: [] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#64748b', font: { size: 11 }, boxWidth: 12 } }
                    },
                    cutout: '65%'
                }
            });

            // Bar Chart
            const ctxBar = document.getElementById('barChart').getContext('2d');
            chartInstances.bar = new Chart(ctxBar, {
                type: 'bar',
                data: { labels: [], datasets: [] },
                options: { ...commonOptions }
            });

            // Status Chart
            const ctxStatus = document.getElementById('statusChart').getContext('2d');
            chartInstances.status = new Chart(ctxStatus, {
                type: 'pie',
                data: { labels: [], datasets: [] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#64748b', font: { size: 11 }, boxWidth: 12 } }
                    }
                }
            });

            updateChartsTheme();
        }

        function updateChartsData() {
            if (!filteredData.length) return;

            // A. Postdoc Year Chart
            const yearsSet = new Set();
            filteredData.forEach(d => {
                if (d['Tahun Lantikan']) yearsSet.add(d['Tahun Lantikan']);
                if (d['Tahun Tamat']) yearsSet.add(d['Tahun Tamat']);
            });
            const sortedYears = Array.from(yearsSet).sort((a, b) => a - b);

            const lantikanCounts = sortedYears.map(yr => 
                filteredData.filter(d => d['Tahun Lantikan'] === yr).length
            );
            const tamatCounts = sortedYears.map(yr => 
                filteredData.filter(d => d['Tahun Tamat'] === yr).length
            );

            chartInstances.postdocYear.data = {
                labels: sortedYears.map(y => `Tahun ${y}`),
                datasets: [
                    { label: 'Bilangan Lantikan', data: lantikanCounts, backgroundColor: chartColors.indigo, borderRadius: 6 },
                    { label: 'Bilangan Tamat', data: tamatCounts, backgroundColor: chartColors.amber, borderRadius: 6 }
                ]
            };
            chartInstances.postdocYear.update();

            // B. Postdoc Country Chart
            const countryCounts = {};
            filteredData.forEach(d => {
                const c = d['Negara'] || 'Lain-lain';
                countryCounts[c] = (countryCounts[c] || 0) + 1;
            });

            chartInstances.postdocCountry.data = {
                labels: Object.keys(countryCounts),
                datasets: [{
                    label: 'Jumlah Postdoc',
                    data: Object.values(countryCounts),
                    backgroundColor: chartColors.palette,
                    borderRadius: 6
                }]
            };
            chartInstances.postdocCountry.update();

            // C. Line Chart
            const lineLabels = filteredData.map((d, i) => d['Demography'] || `Item #${i+1}`).slice(0, 15);
            const pubData = filteredData.map(d => d['KPI Publication']).slice(0, 15);
            const citeData = filteredData.map(d => d['Citation']).slice(0, 15);

            chartInstances.line.data = {
                labels: lineLabels,
                datasets: [
                    { label: 'Publications', data: pubData, borderColor: chartColors.indigo, backgroundColor: 'rgba(99, 102, 241, 0.15)', fill: true, tension: 0.3, borderWidth: 2 },
                    { label: 'Citations', data: citeData, borderColor: chartColors.rose, backgroundColor: 'rgba(244, 63, 94, 0.15)', fill: true, tension: 0.3, borderWidth: 2 }
                ]
            };
            chartInstances.line.update();

            // D. Pie Chart (Demography)
            const demographyCounts = {};
            filteredData.forEach(d => {
                const key = d['Demography'] || 'Unspecified';
                demographyCounts[key] = (demographyCounts[key] || 0) + 1;
            });

            chartInstances.pie.data = {
                labels: Object.keys(demographyCounts),
                datasets: [{ data: Object.values(demographyCounts), backgroundColor: chartColors.palette, borderWidth: 0 }]
            };
            chartInstances.pie.update();

            // E. Bar Chart
            const grantStats = {};
            filteredData.forEach(d => {
                const grant = d['Grant Type'] || 'General';
                if (!grantStats[grant]) grantStats[grant] = { pub: 0, achieved: 0 };
                grantStats[grant].pub += d['KPI Publication'];
                grantStats[grant].achieved += d['KPI Achieved'];
            });

            chartInstances.bar.data = {
                labels: Object.keys(grantStats),
                datasets: [
                    { label: 'KPI Publication', data: Object.values(grantStats).map(s => s.pub), backgroundColor: chartColors.amber, borderRadius: 6 },
                    { label: 'KPI Achieved', data: Object.values(grantStats).map(s => s.achieved), backgroundColor: chartColors.emerald, borderRadius: 6 }
                ]
            };
            chartInstances.bar.update();

            // F. Status Chart
            const pdCounts = {};
            filteredData.forEach(d => {
                const status = d['PD Status'] || 'Unknown';
                pdCounts[status] = (pdCounts[status] || 0) + 1;
            });

            chartInstances.status.data = {
                labels: Object.keys(pdCounts),
                datasets: [{ data: Object.values(pdCounts), backgroundColor: [chartColors.purple, chartColors.cyan, chartColors.blue, chartColors.emerald, chartColors.rose], borderWidth: 0 }]
            };
            chartInstances.status.update();
        }

        function updateChartsTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            const textColor = isDark ? '#94a3b8' : '#475569';
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.06)';

            Object.values(chartInstances).forEach(chart => {
                if (chart.options.scales) {
                    if (chart.options.scales.x) {
                        chart.options.scales.x.ticks.color = textColor;
                        chart.options.scales.x.grid.color = gridColor;
                    }
                    if (chart.options.scales.y) {
                        chart.options.scales.y.ticks.color = textColor;
                        chart.options.scales.y.grid.color = gridColor;
                    }
                }
                if (chart.options.plugins && chart.options.plugins.legend) {
                    chart.options.plugins.legend.labels.color = textColor;
                }
                chart.update();
            });
        }

        function renderTable() {
            const tbody = document.getElementById('tableBody');
            const totalRecords = filteredData.length;
            document.getElementById('recordCounter').innerText = `${totalRecords} Records`;

            if (totalRecords === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="11" class="p-8 text-center text-slate-400">
                            <i class="fa-solid fa-folder-open text-2xl mb-2 text-slate-500"></i>
                            <p>No matching research records found.</p>
                        </td>
                    </tr>`;
                document.getElementById('paginationInfo').innerText = 'Showing 0 of 0 entries';
                document.getElementById('btnPrevPage').disabled = true;
                document.getElementById('btnNextPage').disabled = true;
                return;
            }

            const totalPages = Math.ceil(totalRecords / pageSize);
            if (currentPage > totalPages) currentPage = totalPages;
            
            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = Math.min(startIdx + pageSize, totalRecords);
            const pageData = filteredData.slice(startIdx, endIdx);

            tbody.innerHTML = pageData.map((row, index) => `
                <tr class="hover:bg-slate-100 dark:hover:bg-slate-800/40 transition">
                    <td class="p-3 text-slate-400 font-mono">${startIdx + index + 1}</td>
                    <td class="p-3 font-medium text-slate-900 dark:text-slate-100">${escapeHtml(row['Demography'])}</td>
                    <td class="p-3 font-medium text-slate-700 dark:text-slate-300">
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                            <i class="fa-solid fa-earth-americas text-indigo-500 text-[10px]"></i>
                            ${escapeHtml(row['Negara'])}
                        </span>
                    </td>
                    <td class="p-3 font-mono text-slate-600 dark:text-slate-400">${row['Tahun Lantikan']}</td>
                    <td class="p-3 font-mono text-slate-600 dark:text-slate-400">${row['Tahun Tamat']}</td>
                    <td class="p-3">
                        <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
                            ${escapeHtml(row['Grant Type'])}
                        </span>
                    </td>
                    <td class="p-3">
                        <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium ${getStatusBadgeStyle(row['PD Status'])}">
                            ${escapeHtml(row['PD Status'])}
                        </span>
                    </td>
                    <td class="p-3 font-semibold text-slate-900 dark:text-slate-100">${formatNumber(row['KPI Publication'])}</td>
                    <td class="p-3 font-semibold text-emerald-600 dark:text-emerald-400">${formatNumber(row['KPI Achieved'])}</td>
                    <td class="p-3 font-semibold text-rose-600 dark:text-rose-400">${formatNumber(row['Citation'])}</td>
                    <td class="p-3 font-bold text-violet-600 dark:text-violet-400">${row['H-Index']}</td>
                </tr>
            `).join('');

            document.getElementById('paginationInfo').innerText = `Showing ${startIdx + 1} to ${endIdx} of ${totalRecords} entries`;
            document.getElementById('currentPageNum').innerText = currentPage;
            document.getElementById('btnPrevPage').disabled = currentPage === 1;
            document.getElementById('btnNextPage').disabled = currentPage >= totalPages;
        }

        function changePage(direction) {
            currentPage += direction;
            renderTable();
        }

        function getStatusBadgeStyle(status) {
            const s = String(status).toLowerCase();
            if (s.includes('active') || s.includes('completed') || s.includes('achieved')) {
                return 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
            } else if (s.includes('pending') || s.includes('progress')) {
                return 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20';
            } else {
                return 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20';
            }
        }

        function startAutoRefreshTimer() {
            if (refreshTimer) clearInterval(refreshTimer);
            
            timerSeconds = 300;
            updateTimerDisplay();

            refreshTimer = setInterval(() => {
                timerSeconds--;
                updateTimerDisplay();

                if (timerSeconds <= 0) {
                    timerSeconds = 300;
                    fetchLiveData();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timerSeconds / 60);
            const secs = timerSeconds % 60;
            const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            document.getElementById('timerDisplay').innerText = formatted;
        }

        function manualRefreshData() {
            fetchLiveData();
            startAutoRefreshTimer();
        }

        function showRefreshSpin(isSpinning) {
            const icon = document.getElementById('refreshIcon');
            if (isSpinning) {
                icon.classList.add('fa-spin');
            } else {
                icon.classList.remove('fa-spin');
            }
        }

        function updateTimestamp() {
            const now = new Date();
            document.getElementById('lastUpdated').innerText = now.toLocaleTimeString();
        }

        function showAlert(msg, type = 'info') {
            const alertBox = document.getElementById('statusAlert');
            const alertTitle = document.getElementById('statusTitle');
            const alertMsg = document.getElementById('statusMsg');
            const alertIcon = document.getElementById('statusIcon');

            alertMsg.innerText = msg;
            alertBox.classList.remove('hidden', 'bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-700', 'bg-amber-500/10', 'border-amber-500/30', 'text-amber-700', 'bg-rose-500/10', 'border-rose-500/30', 'text-rose-700');

            if (type === 'success') {
                alertTitle.innerText = 'Sync Complete';
                alertBox.classList.add('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-700', 'dark:text-emerald-300');
                alertIcon.className = 'fa-solid fa-circle-check text-emerald-500 text-xl';
            } else if (type === 'warning') {
                alertTitle.innerText = 'Data Pipeline Notice';
                alertBox.classList.add('bg-amber-500/10', 'border-amber-500/30', 'text-amber-700', 'dark:text-amber-300');
                alertIcon.className = 'fa-solid fa-triangle-exclamation text-amber-500 text-xl';
            } else {
                alertTitle.innerText = 'System Alert';
                alertBox.classList.add('bg-rose-500/10', 'border-rose-500/30', 'text-rose-700', 'dark:text-rose-300');
                alertIcon.className = 'fa-solid fa-circle-xmark text-rose-500 text-xl';
            }

            alertBox.classList.remove('hidden');
            setTimeout(() => { dismissAlert(); }, 6000);
        }

        function dismissAlert() {
            document.getElementById('statusAlert').classList.add('hidden');
        }

        function exportTableToCSV() {
            if (!filteredData || !filteredData.length) return;
            
            const exportData = filteredData.map(d => ({
                'Demography': d['Demography'],
                'Negara': d['Negara'],
                'Tahun Lantikan': d['Tahun Lantikan'],
                'Tahun Tamat': d['Tahun Tamat'],
                'Grant Type': d['Grant Type'],
                'PD Status': d['PD Status'],
                'KPI Publication': d['KPI Publication'],
                'KPI Achieved': d['KPI Achieved'],
                'Citation': d['Citation'],
                'H-Index': d['H-Index']
            }));

            const csv = Papa.unparse(exportData);
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', `Research_Postdoc_Export_${new Date().toISOString().slice(0,10)}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

